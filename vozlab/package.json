{
  "name": "vozlab-desktop",
  "version": "0.1.6",
  "private": true,
  "description": "Mettavox Clonner — estúdio local de clonagem de voz e locução",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "br.vozlab.desktop",
    "productName": "Mettavox Clonner",
    "directories": { "output": "dist" },
    "files": ["electron/**/*", "ui/**/*", "package.json"],
    "extraResources": [{ "from": "../dist-engine/VozLabEngine", "to": "engine" }],
    "win": { "target": ["nsis"], "artifactName": "Mettavox-Clonner-Setup-${version}-${arch}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}
